{
  "name": "instrukt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --d1=DB --kv=CACHE --r2=FILES --port=8788",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:local": "wrangler d1 execute dsms-mt-db --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute dsms-mt-db --local --file=./migrations/0002_seed.sql",
    "db:remote": "wrangler d1 execute dsms-mt-db --remote --file=./migrations/0001_init.sql",
    "db:seed:remote": "wrangler d1 execute dsms-mt-db --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.78.0"
  }
}
